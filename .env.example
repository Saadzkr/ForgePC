# Database
# Use Neon (free) or Vercel Postgres
# Sign up at https://neon.tech → create project → copy connection string (use pooled connection)
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth — REQUIRED for production
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_URL="https://forgepc2026.vercel.app"
NEXTAUTH_SECRET="replace-with-random-32-char-secret"

# OAuth Providers (optional)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Forge PC"
