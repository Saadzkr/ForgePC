# Database
# Local: Use a local PostgreSQL instance or Docker:
#   docker run --name forge-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16-alpine
# Production: Use Neon (free) or Vercel Postgres
#   Sign up at https://neon.tech → create project → copy connection string (use pooled connection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge_pc?schema=public"

# NextAuth — REQUIRED for production
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-random-secret-at-least-32-chars"

# OAuth Providers (optional)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Forge PC"
